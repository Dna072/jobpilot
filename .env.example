# JobPilot environment — copy to .env and fill in. Never commit .env.

# --- Core ---
JOBPILOT_ENV=development
JOBPILOT_CONFIG=config/jobpilot.yaml
DATABASE_URL=postgresql+psycopg://jobpilot:jobpilot@postgres:5432/jobpilot
REDIS_URL=redis://redis:6379/0
JOBPILOT_ALLOW_LIVE_APPLY=false

# --- LLM (optional; heuristic fallback always works) ---
LLM_PROVIDER=heuristic
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Email ---
EMAIL_PROVIDER=smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=derrick.adjei.eng@gmail.com

# --- Job sources (optional) ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
GITHUB_TOKEN=
GITHUB_USERNAME=Dna072

# --- HTTP ---
HTTP_USER_AGENT=JobPilot/0.1 (+https://github.com/Dna072/jobpilot; derrick.adjei.eng@gmail.com)
PORT=8080

# --- GCP (Cloud Run / Scheduler) ---
JOBPILOT_OPS_TOKEN=
GCS_BUCKET=
GCS_PREFIX=jobpilot
GCP_PROJECT=
GCP_REGION=europe-north1
